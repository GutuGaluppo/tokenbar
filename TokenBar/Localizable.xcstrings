    "%@ das respostas do Opus têm menos de 1k tokens de saída (%lld respostas, %@). Estimativa supõe que metade poderia rodar no Sonnet 5.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of Opus responses have under 1k output tokens (%lld responses, %@). Estimate assumes half could run on Sonnet 5."
          }
        }
      }
    },
    "%@ de %@": {
      "localizations": {
