    "Antes da primeira pergunta: prompt de sistema, AGENTS.md e ferramentas de MCP. Veja o uso de contexto com /status.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before your first question: system prompt, AGENTS.md and MCP tools. Check context usage with /status."
          }
        }
      }
    },
    "Antes da primeira pergunta: prompt de sistema, CLAUDE.md, ferramentas de MCP, skills e plugins. Veja o que ocupa espaço com /context.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before your first question: system prompt, CLAUDE.md, MCP tools, skills and plugins. See what takes up space with /context."
          }
        }
      }
    },
    "Ao passar para %@, %@ tokens foram gravados de novo no cache%@. Numa conversa longa, compacte antes de trocar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching to %@ rewrote %@ tokens to the cache%@. In a long conversation, compact before switching."
          }
        }
      }
    },
