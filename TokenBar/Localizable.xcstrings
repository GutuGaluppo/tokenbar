    "%lld leituras e buscas em 15 min, todas no contexto. Um subagente de exploração faz isso à parte e devolve só o resumo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld reads and searches in 15 min, all in the context. An exploration subagent does this separately and returns only a summary."
          }
        }
      }
    },
    "%lld modelos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld models"
          }
        }
      }
    },
    "%lld respostas de modelos sem preço na tabela (custo contado como US$ 0).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld responses from models without a price in the table (cost counted as US$ 0)."
          }
        }
      }
    },
    "%lld respostas em %lld sessões rodaram com mais de 200k tokens de contexto. A parte acima de 100k custou %@ em %lld dias.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld responses in %lld sessions ran with more than 200k tokens of context. The part above 100k cost %@ in %lld days."
          }
        }
      }
    },
    "%lld respostas no Opus 5 em %lld dias (%@). O Opus 5.5 é o sucessor na mesma linha: 20%% menos na entrada e na saída e 60%% menos na leitura de cache.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld responses on Opus 5 in %lld days (%@). Opus 5.5 is its successor in the same line: 20%% cheaper for input and output and 60%% cheaper for cache reads."
          }
        }
      }
    },
    "%lld respostas passaram de 8k tokens de saída (%@ só em saída). Estimativa de 30%% a menos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld responses exceeded 8k output tokens (%@ in output alone). Estimate: 30%% less."
          }
        }
      }
    },
    "%lld sessões começaram com %@ tokens em média antes da primeira pergunta — prompt de sistema, CLAUDE.md, ferramentas de MCP, skills e plugins. Estimativa para reduzir a ~25k.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessions started with %@ tokens on average before the first question — system prompt, CLAUDE.md, MCP tools, skills and plugins. Estimate for trimming to ~25k."
          }
        }
      }
    },
