    "%@ das respostas do Opus têm menos de 1k tokens de saída (%lld respostas, %@). Estimativa supõe que metade poderia rodar no Sonnet 5.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of Opus responses have under 1k output tokens (%lld responses, %@). Estimate assumes half could run on Sonnet 5."
          }
        }
      }
    },
    "%@ de %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@"
          }
        }
      }
    },
    "%@ em %lld dias na API Anthropic sem batch. A Batch API custa 50%% menos; estimativa supõe que 25%% do volume pode esperar até 24 h.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in %lld days on the Anthropic API without batching. The Batch API costs 50%% less; estimate assumes 25%% of the volume can wait up to 24 h."
          }
        }
      }
    },
