    "0 desliga o limite. Pressione Enter para confirmar o valor. Soma todas as fontes: Claude Code, API Anthropic e API OpenAI.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 turns the limit off. Press Return to confirm the value. Adds up all sources: Claude Code, Anthropic API and OpenAI API."
          }
        }
      }
    },
